PORT=3001
NODE_ENV=development

# Encryption key for storing passwords (CHANGE THIS!)
# Generate a secure key with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=change-this-to-a-secure-random-key-at-least-32-characters-long

# ── Firestore (reservation storage) ────────────────────────────────────────
# Required. GCP project the Firestore database lives in (see infra/).
#
# Local dev: run the emulator instead of hitting real GCP —
#   gcloud emulators firestore start --host-port=localhost:8081
#   export FIRESTORE_EMULATOR_HOST=localhost:8081
# When FIRESTORE_EMULATOR_HOST is set, @google-cloud/firestore talks to the
# emulator automatically; GCP_PROJECT_ID can be any placeholder in that case.
GCP_PROJECT_ID=your-gcp-project-id

# ── Cloud Tasks (production deploys only) ──────────────────────────────────
# Leave all of these unset for local dev — the app falls back to the
# in-process cron scheduler (scheduler/index.ts) instead of dispatching to
# a separate worker service. Terraform (infra/) provisions and wires these
# for you; see infra/README.md.
# GCP_REGION=us-central1
# WORKER_URL=https://res-bot-worker-xxxxx.a.run.app
# CONTROL_PLANE_SERVICE_ACCOUNT_EMAIL=res-bot-control-plane@your-gcp-project-id.iam.gserviceaccount.com
# TASKS_QUEUE_ID=res-bot-booking-jobs
# INTERNAL_CALLBACK_TOKEN=shared-secret-the-worker-attaches-when-posting-status-back

# ── Email notifications ────────────────────────────────────────────────────
# Optional. When set, Res Bot emails every booking result to SMTP_TO.
#
# Gmail quick-start:
#   1. Enable 2FA on your Google account
#   2. Generate an App Password at https://myaccount.google.com/apppasswords
#   3. Use smtp.gmail.com:465 (SSL) or smtp.gmail.com:587 (STARTTLS)
#
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=Res Bot <you@gmail.com>
SMTP_TO=you@gmail.com,partner@example.com
